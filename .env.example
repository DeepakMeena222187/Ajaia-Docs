# Copy to .env.local for local development, or set these in your hosting dashboard.
# Never commit real values.

# Postgres connection string. On Supabase use the Transaction Pooler URL (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/greenleaf"

# Optional: direct (non-pooled) URL used only by `npm run db:migrate` / `db:seed`.
# On Supabase use the Session Pooler or direct connection (port 5432).
DIRECT_URL=""

# Set to 1 only if you self-host behind a reverse proxy (nginx, Caddy, Cloudflare) that
# overwrites X-Forwarded-For. Leave unset on Vercel (detected automatically).
TRUST_PROXY=""

# Required when running more than one server instance outside Vercel: a stable
# base64 32-byte key so Server Action references work across instances.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Test database (wiped on every `npm test`; its name must contain "test").
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/greenleaf_test"
